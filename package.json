{
	"name": "template-react",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"lint-staged": "lint-staged --allow-empty"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.10.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"react-router": "^7.9.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^24.10.0",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react-swc": "^4.2.1",
		"eslint": "^9.39.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"typescript": "~5.9.3",
		"vite": "^7.2.2"
	},
	"lint-staged": {
		"src/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --verbose --no-errors-on-unmatched"
		]
	}
}
